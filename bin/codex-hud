#!/usr/bin/env bash
#
# codex-hud - Wrapper script for Codex CLI with HUD display
# Launches Codex in a tmux session with a status bar pane
#
# Environment variables:
#   CODEX_HUD_POSITION - HUD pane position: bottom (default), top
#   CODEX_HUD_HEIGHT   - HUD pane height in lines (default: 5)
#   CODEX_HUD_HEIGHT_AUTO - Auto-adjust HUD height based on pane width (default: 0)
#   CODEX_HUD_HEIGHT_MIN - Minimum HUD height when auto-adjusting (default: CODEX_HUD_HEIGHT)
#   CODEX_HUD_HEIGHT_MAX - Maximum HUD height when auto-adjusting (default: 12)
#   CODEX_HUD_AUTO_ATTACH - If set to true, auto-attach to existing session
#   CODEX_HUD_NO_ATTACH - Deprecated: if set to true, do not attach to existing session
#   CODEX_HUD_ALTERNATE_SCREEN - Use alternate screen in codex pane (default: 0)
#   CODEX_HUD_MOUSE - Enable tmux mouse mode for this session (default: 1)
#   CODEX_HUD_BIND_TOGGLE - Install the legacy server-wide Prefix+H toggle (default: 0)
#   CODEX_HUD_CLEAR_SCROLLBACK - If set to 1, clears tmux scrollback on first render
#   CODEX_HUD_SQLITE_ISOLATION - Use a launch-scoped SQLite home (default: 0)
#   CODEX_HUD_UPDATE_CHECK - Set to 0 or false to disable release checks and prompts
#

set -e

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HUD_DIR="$(dirname "$SCRIPT_DIR")"
HUD_HEIGHT="${CODEX_HUD_HEIGHT:-}"
HUD_POSITION="${CODEX_HUD_POSITION:-bottom}"
ALIAS_MARKER="# codex-hud alias"
# Keep provider classification and compatibility selectors in one table. Adding
# a launch profile requires one row here; the tmux lifecycle below consumes the
# resolved command vector without provider-specific branches.
#
# Fields:
#   profile|executable|subcommand|home_suffix|sessions_suffix|session_tag
#     |legacy_activation_envs|legacy_required_envs|legacy_cli_env
#     |legacy_session_prefix_env|legacy_shell_env|legacy_subcommand
#     |legacy_command_mode
LAUNCH_PROFILE_REGISTRY=(
    "native|codex|||||||||||profile"
    "stepcode|stepcode|codex|/.stepcode/codex|/.codex/sessions|stepcode|CODEX_HUD_CLI_PATH,CODEX_HUD_SESSION_PREFIX|CODEX_HUD_CLI_PATH,CODEX_HUD_SESSION_PREFIX,CODEX_HUD_SHELL_PATH|CODEX_HUD_CLI_PATH|CODEX_HUD_SESSION_PREFIX|CODEX_HUD_SHELL_PATH||direct"
)
LAUNCH_PROFILE="native"
LAUNCH_PROFILE_EXPLICIT="0"
LAUNCH_PROFILE_SOURCE="default"
LAUNCH_PROFILE_EXECUTABLE=""
LAUNCH_PROFILE_SUBCOMMAND=""
LAUNCH_PROFILE_LEGACY_SUBCOMMAND=""
LAUNCH_PROFILE_LEGACY_COMMAND_MODE=""
LAUNCH_PROFILE_CODEX_HOME_SUFFIX=""
LAUNCH_PROFILE_CODEX_SESSIONS_SUFFIX=""
LAUNCH_PROFILE_SESSION_TAG=""
LAUNCH_PROFILE_LEGACY_ACTIVATION_ENVS=""
LAUNCH_PROFILE_LEGACY_REQUIRED_ENVS=""
LAUNCH_PROFILE_CLI_ENV=""
LAUNCH_PROFILE_SESSION_PREFIX_ENV=""
LAUNCH_PROFILE_SHELL_ENV=""
CODEX_CLI_COMMAND=()
CODEX_HOME_OVERRIDE=""
CODEX_SESSIONS_OVERRIDE=""
CODEX_PANE_SHELL_PATH=""
CODEX_SESSION_PREFIX_OVERRIDE=""
CODEX_SQLITE_HOME_OVERRIDE=""
CODEX_SQLITE_HOME_SOURCE=""
CODEX_SQLITE_HOME_EXPLICIT="0"
CODEX_SQLITE_ISOLATION_ENABLED="0"
UPDATE_HELPER_PATH="$SCRIPT_DIR/codex-hud-update.mjs"
UPDATE_UPGRADE_PATH="$SCRIPT_DIR/codex-hud-upgrade"
FORCE_ATTACH="0"
FORCE_NEW_SESSION="0"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print error message and exit
error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

# Print warning message
warn() {
    echo -e "${YELLOW}Warning:${NC} $1" >&2
}

# Print info message
info() {
    echo -e "${GREEN}Info:${NC} $1"
}

# Print step message
step() {
    echo -e "${BLUE}==>${NC} $1"
}

# Check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

shell_quote() {
    local value="$1"
    value="${value//\'/\'\\\'\'}"
    printf "'%s'" "$value"
}

update_checks_disabled() {
    local value="${CODEX_HUD_UPDATE_CHECK:-}"
    value=$(printf "%s" "$value" | tr '[:upper:]' '[:lower:]')
    [[ "$value" == "0" || "$value" == "false" ]]
}

run_update_helper() {
    local command_name="$1"
    shift
    if [[ ! -f "$UPDATE_HELPER_PATH" ]]; then
        warn "Update helper is missing: $UPDATE_HELPER_PATH"
        return 1
    fi
    if ! command_exists node; then
        warn "Node.js is unavailable; skipping codex-hud update helper."
        return 1
    fi
    node "$UPDATE_HELPER_PATH" "$command_name" "$@"
}

run_update_check() {
    local checkout_path="$1"
    if update_checks_disabled; then
        return 0
    fi
    if ! run_update_helper check --checkout "$checkout_path" --upgrade-command "$UPDATE_UPGRADE_PATH"; then
        warn "The optional codex-hud update check failed; continuing to start Codex."
    fi
}

register_update_session() {
    local checkout_path="$1"
    if update_checks_disabled; then
        return 0
    fi
    if ! run_update_helper register-session --checkout "$checkout_path" --session "$SESSION_NAME" --upgrade-command "$UPDATE_UPGRADE_PATH"; then
        warn "The optional deferred update registration failed; continuing to start Codex."
        abort_update_session "$checkout_path"
    fi
}

abort_update_session() {
    local checkout_path="$1"
    if update_checks_disabled; then
        return 0
    fi
    if ! run_update_helper abort-session --checkout "$checkout_path" --session "$SESSION_NAME"; then
        warn "The optional deferred update abort failed; continuing orphan cleanup."
    fi
}

parse_boolean_setting() {
    local name="$1"
    local raw="$2"
    local default_value="$3"

    if [[ -z "$raw" ]]; then
        echo "$default_value"
        return 0
    fi

    local lowered
    lowered=$(printf "%s" "$raw" | tr '[:upper:]' '[:lower:]')

    case "$lowered" in
        1|true|on|yes)
            echo "1"
            ;;
        0|false|off|no)
            echo "0"
            ;;
        *)
            echo "Error: $name must be one of: 1, 0, true, false, on, off, yes, no (got: $raw)" >&2
            return 1
            ;;
    esac
}

resolve_attach_policy() {
    local auto_attach
    local no_attach

    auto_attach=$(parse_boolean_setting "CODEX_HUD_AUTO_ATTACH" "${CODEX_HUD_AUTO_ATTACH:-}" "0") || return 1
    no_attach=$(parse_boolean_setting "CODEX_HUD_NO_ATTACH" "${CODEX_HUD_NO_ATTACH:-}" "0") || return 1

    if [[ "$FORCE_NEW_SESSION" == "1" ]]; then
        echo "new"
        return 0
    fi

    if [[ "$FORCE_ATTACH" == "1" ]]; then
        echo "attach"
        return 0
    fi

    if [[ "$no_attach" == "1" ]]; then
        warn "CODEX_HUD_NO_ATTACH is deprecated; use --new-session or unset CODEX_HUD_AUTO_ATTACH instead."
        echo "new"
        return 0
    fi

    if [[ "$auto_attach" == "1" ]]; then
        echo "attach"
        return 0
    fi

    echo "new"
}

resolve_alternate_screen_setting() {
    parse_boolean_setting "CODEX_HUD_ALTERNATE_SCREEN" "${CODEX_HUD_ALTERNATE_SCREEN:-}" "0"
}

hash_cwd() {
    local cwd="$1"
    local hash=""
    if command_exists md5sum; then
        hash=$(printf "%s" "$cwd" | md5sum | awk '{print $1}')
    elif command_exists md5; then
        hash=$(printf "%s" "$cwd" | md5 -q 2>/dev/null || printf "%s" "$cwd" | md5 | awk '{print $NF}')
    elif command_exists shasum; then
        hash=$(printf "%s" "$cwd" | shasum -a 256 | awk '{print $1}')
    fi
    if [[ -n "$hash" ]]; then
        echo "${hash:0:8}"
    else
        echo "$$"
    fi
}

# Generate a shell-safe project component for human-readable session names.
session_project_slug() {
    local project_name
    project_name=$(basename "$1")
    if [[ "$project_name" == "/" || -z "$project_name" ]]; then
        project_name="root"
    fi

    project_name=$(printf "%s" "$project_name" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//')
    if [[ -z "$project_name" ]]; then
        project_name="proj-$(hash_cwd "$1")"
    fi
    printf "%.32s" "$project_name"
}

# Generate a project-readable session name while retaining path uniqueness.
PROJECT_SLUG="$(session_project_slug "$PWD")"
SESSION_HASH="$(hash_cwd "$PWD")"
SESSION_PREFIX=""
SESSION_NAME=""

refresh_session_identity() {
    local session_prefix_base="codex-hud"
    if [[ -n "$CODEX_SESSION_PREFIX_OVERRIDE" ]]; then
        session_prefix_base="$CODEX_SESSION_PREFIX_OVERRIDE"
    elif [[ -n "$LAUNCH_PROFILE_SESSION_TAG" ]]; then
        session_prefix_base="codex-hud-${LAUNCH_PROFILE_SESSION_TAG}"
    fi

    if [[ -n "$session_prefix_base" ]]; then
        SESSION_PREFIX="${session_prefix_base}-${PROJECT_SLUG}-${SESSION_HASH}"
    fi
    SESSION_NAME="${SESSION_PREFIX}-$(date +%Y%m%d%H%M%S)-$$"
}

refresh_session_identity

load_launch_profile_record() {
    local requested_profile="$1"
    local profile_found="0"
    local registry_entry

    for registry_entry in "${LAUNCH_PROFILE_REGISTRY[@]}"; do
        local profile_name
        local executable
        local subcommand
        local codex_home_suffix
        local codex_sessions_suffix
        local session_tag
        local legacy_activation_envs
        local legacy_required_envs
        local cli_env
        local session_prefix_env
        local shell_env
        local legacy_subcommand
        local legacy_command_mode
        IFS='|' read -r profile_name executable subcommand codex_home_suffix codex_sessions_suffix session_tag legacy_activation_envs legacy_required_envs cli_env session_prefix_env shell_env legacy_subcommand legacy_command_mode <<< "$registry_entry"
        if [[ "$profile_name" == "$requested_profile" ]]; then
            LAUNCH_PROFILE_EXECUTABLE="$executable"
            LAUNCH_PROFILE_SUBCOMMAND="$subcommand"
            LAUNCH_PROFILE_LEGACY_SUBCOMMAND="$legacy_subcommand"
            LAUNCH_PROFILE_LEGACY_COMMAND_MODE="$legacy_command_mode"
            LAUNCH_PROFILE_CODEX_HOME_SUFFIX="$codex_home_suffix"
            LAUNCH_PROFILE_CODEX_SESSIONS_SUFFIX="$codex_sessions_suffix"
            LAUNCH_PROFILE_SESSION_TAG="$session_tag"
            LAUNCH_PROFILE_LEGACY_ACTIVATION_ENVS="$legacy_activation_envs"
            LAUNCH_PROFILE_LEGACY_REQUIRED_ENVS="$legacy_required_envs"
            LAUNCH_PROFILE_CLI_ENV="$cli_env"
            LAUNCH_PROFILE_SESSION_PREFIX_ENV="$session_prefix_env"
            LAUNCH_PROFILE_SHELL_ENV="$shell_env"
            profile_found="1"
            break
        fi
    done

    if [[ "$profile_found" != "1" ]]; then
        error "Unsupported Codex launch profile: $requested_profile"
    fi
}

# Validate a comma-separated list of environment variable names declared by a
# launch profile. Registry rows are trusted source data, but validating them at
# the boundary keeps malformed additions visible instead of silently changing
# launch selection.
validate_legacy_env_list() {
    local env_list="$1"
    local label="$2"
    local -a env_names=()
    local env_name

    if [[ -z "$env_list" ]]; then
        return 0
    fi

    IFS=',' read -r -a env_names <<< "$env_list"
    if [[ "${#env_names[@]}" -eq 0 ]]; then
        error "Launch profile '$label' declares an empty legacy environment list."
    fi
    for env_name in "${env_names[@]}"; do
        if [[ -z "$env_name" || ! "$env_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            error "Launch profile '$label' declares an invalid legacy environment name: ${env_name:-<empty>}"
        fi
    done
}

legacy_env_list_contains() {
    local env_list="$1"
    local env_name="$2"
    [[ ",$env_list," == *",$env_name,"* ]]
}

validate_legacy_profile_declaration() {
    local profile_name="$1"
    local activation_envs="$2"
    local required_envs="$3"
    local cli_env="$4"
    local session_prefix_env="$5"
    local shell_env="$6"

    if [[ -z "$activation_envs" ]]; then
        return 0
    fi
    if [[ -z "$required_envs" ]]; then
        error "Launch profile '$profile_name' declares legacy activation without required environments."
    fi

    validate_legacy_env_list "$activation_envs" "$profile_name"
    validate_legacy_env_list "$required_envs" "$profile_name"

    local -a env_names=()
    local env_name
    IFS=',' read -r -a env_names <<< "$activation_envs"
    for env_name in "${env_names[@]}"; do
        if ! legacy_env_list_contains "$required_envs" "$env_name"; then
            error "Launch profile '$profile_name' activates on undeclared legacy environment: $env_name"
        fi
    done

    for env_name in "$cli_env" "$session_prefix_env" "$shell_env"; do
        if [[ -n "$env_name" ]] && ! legacy_env_list_contains "$required_envs" "$env_name"; then
            error "Launch profile '$profile_name' uses undeclared legacy environment: $env_name"
        fi
    done
}

# Select a profile from the legacy shell environment only when the caller did
# not pass an explicit wrapper profile flag. Activation and required variable
# names come from the registry row, so future profiles use the same mechanism.
resolve_legacy_launch_profile() {
    if [[ "$LAUNCH_PROFILE_EXPLICIT" == "1" ]]; then
        return 0
    fi

    local selected_profile=""
    local registry_entry

    for registry_entry in "${LAUNCH_PROFILE_REGISTRY[@]}"; do
        local profile_name
        local executable
        local subcommand
        local codex_home_suffix
        local codex_sessions_suffix
        local session_tag
        local legacy_activation_envs
        local legacy_required_envs
        local cli_env
        local session_prefix_env
        local shell_env
        local legacy_subcommand
        local legacy_command_mode
        IFS='|' read -r profile_name executable subcommand codex_home_suffix codex_sessions_suffix session_tag legacy_activation_envs legacy_required_envs cli_env session_prefix_env shell_env legacy_subcommand legacy_command_mode <<< "$registry_entry"
        if [[ -z "$legacy_activation_envs" ]]; then
            continue
        fi

        validate_legacy_profile_declaration "$profile_name" "$legacy_activation_envs" "$legacy_required_envs" "$cli_env" "$session_prefix_env" "$shell_env"

        local activation_present="0"
        local -a activation_env_names=()
        local env_name
        IFS=',' read -r -a activation_env_names <<< "$legacy_activation_envs"
        for env_name in "${activation_env_names[@]}"; do
            if [[ -n "${!env_name+x}" ]]; then
                activation_present="1"
                break
            fi
        done
        if [[ "$activation_present" == "0" ]]; then
            continue
        fi

        local -a required_env_names=()
        local missing_envs=""
        IFS=',' read -r -a required_env_names <<< "$legacy_required_envs"
        for env_name in "${required_env_names[@]}"; do
            if [[ -z "${!env_name-}" ]]; then
                if [[ -n "$missing_envs" ]]; then
                    missing_envs="$missing_envs,"
                fi
                missing_envs="$missing_envs$env_name"
            fi
        done
        if [[ -n "$missing_envs" ]]; then
            error "Launch profile '$profile_name' requires these legacy environments to be set and non-empty: $missing_envs"
        fi

        if [[ -n "$selected_profile" && "$selected_profile" != "$profile_name" ]]; then
            error "Legacy launch environment matches multiple Codex profiles: $selected_profile and $profile_name."
        fi
        selected_profile="$profile_name"
    done

    if [[ -z "$selected_profile" ]]; then
        return 0
    fi

    LAUNCH_PROFILE="$selected_profile"
    LAUNCH_PROFILE_SOURCE="legacy-env"
}

validate_session_prefix() {
    local prefix="$1"
    if [[ -z "$prefix" ]]; then
        error "${LAUNCH_PROFILE_SESSION_PREFIX_ENV:-CODEX_HUD_SESSION_PREFIX} must be non-empty."
    fi
    # Session names are embedded in tmux targets, hooks, and prefix filters.
    # Restrict the compatibility value to a portable, shell-safe token.
    if [[ ! "$prefix" =~ ^[A-Za-z0-9_-]+$ ]]; then
        error "${LAUNCH_PROFILE_SESSION_PREFIX_ENV:-CODEX_HUD_SESSION_PREFIX} must contain only letters, digits, '_' or '-' (got: $prefix)."
    fi
    if [[ "${#prefix}" -gt 64 ]]; then
        error "${LAUNCH_PROFILE_SESSION_PREFIX_ENV:-CODEX_HUD_SESSION_PREFIX} is too long (maximum 64 characters)."
    fi
}

validate_shell_path() {
    local shell_path="$1"
    local shell_env_name="${LAUNCH_PROFILE_SHELL_ENV:-CODEX_HUD_SHELL_PATH}"

    if [[ -z "$shell_path" ]]; then
        error "$shell_env_name must be non-empty."
    fi
    if [[ "$shell_path" != /* ]]; then
        error "$shell_env_name must be an absolute executable path (got: $shell_path)."
    fi
    if [[ "$shell_path" == *$'\n'* || "$shell_path" == *$'\r'* ]]; then
        error "$shell_env_name contains a newline, which is not a valid shell path."
    fi
    if [[ ! -f "$shell_path" || ! -x "$shell_path" ]]; then
        error "Configured HUD shell is missing or not executable: $shell_path"
    fi
    CODEX_PANE_SHELL_PATH="$shell_path"
}

validate_legacy_launch_environment() {
    if [[ "$LAUNCH_PROFILE_SOURCE" != "legacy-env" ]]; then
        return 0
    fi

    validate_legacy_profile_declaration \
        "$LAUNCH_PROFILE" \
        "$LAUNCH_PROFILE_LEGACY_ACTIVATION_ENVS" \
        "$LAUNCH_PROFILE_LEGACY_REQUIRED_ENVS" \
        "$LAUNCH_PROFILE_CLI_ENV" \
        "$LAUNCH_PROFILE_SESSION_PREFIX_ENV" \
        "$LAUNCH_PROFILE_SHELL_ENV"

    local -a required_env_names=()
    local env_name
    local missing_envs=""
    IFS=',' read -r -a required_env_names <<< "$LAUNCH_PROFILE_LEGACY_REQUIRED_ENVS"
    for env_name in "${required_env_names[@]}"; do
        if [[ -z "${!env_name-}" ]]; then
            if [[ -n "$missing_envs" ]]; then
                missing_envs="$missing_envs,"
            fi
            missing_envs="$missing_envs$env_name"
        fi
    done
    if [[ -n "$missing_envs" ]]; then
        error "Launch profile '$LAUNCH_PROFILE' requires these legacy environments to be set and non-empty: $missing_envs"
    fi

    if [[ -n "$LAUNCH_PROFILE_CLI_ENV" ]]; then
        local cli_path="${!LAUNCH_PROFILE_CLI_ENV-}"
        if [[ "$cli_path" != /* ]]; then
            error "${LAUNCH_PROFILE_CLI_ENV} must be an absolute executable path (got: $cli_path)."
        fi
        if [[ "$cli_path" == *$'\n'* || "$cli_path" == *$'\r'* ]]; then
            error "${LAUNCH_PROFILE_CLI_ENV} contains a newline, which is not a valid executable path."
        fi
        if [[ ! -f "$cli_path" || ! -x "$cli_path" ]]; then
            error "Configured Codex CLI is missing or not executable: $cli_path"
        fi
        if [[ "$cli_path" -ef "$SCRIPT_DIR/codex-hud" ]]; then
            error "${LAUNCH_PROFILE_CLI_ENV} resolves to codex-hud wrapper. Fix the launch command to point to the real executable."
        fi
    fi

    if [[ -n "$LAUNCH_PROFILE_SESSION_PREFIX_ENV" ]]; then
        validate_session_prefix "${!LAUNCH_PROFILE_SESSION_PREFIX_ENV-}"
        CODEX_SESSION_PREFIX_OVERRIDE="${!LAUNCH_PROFILE_SESSION_PREFIX_ENV}"
    fi
    if [[ -n "$LAUNCH_PROFILE_SHELL_ENV" ]]; then
        validate_shell_path "${!LAUNCH_PROFILE_SHELL_ENV-}"
    fi
    CODEX_CLI_COMMAND=()
}

resolve_launch_profile() {
    load_launch_profile_record "$LAUNCH_PROFILE"
    validate_legacy_profile_declaration \
        "$LAUNCH_PROFILE" \
        "$LAUNCH_PROFILE_LEGACY_ACTIVATION_ENVS" \
        "$LAUNCH_PROFILE_LEGACY_REQUIRED_ENVS" \
        "$LAUNCH_PROFILE_CLI_ENV" \
        "$LAUNCH_PROFILE_SESSION_PREFIX_ENV" \
        "$LAUNCH_PROFILE_SHELL_ENV"

    if [[ "$LAUNCH_PROFILE_SOURCE" == "legacy-env" ]]; then
        validate_legacy_launch_environment
    elif [[ "$LAUNCH_PROFILE_EXPLICIT" != "1" && -n "${CODEX_HUD_SHELL_PATH:-}" ]]; then
        # Preserve the historical standalone shell override for native
        # launches. An explicit profile flag owns the complete launch
        # contract, so legacy environment values remain inert.
        validate_shell_path "$CODEX_HUD_SHELL_PATH"
    fi
}

resolve_launch_command() {
    resolve_launch_profile

    local executable="$LAUNCH_PROFILE_EXECUTABLE"
    local subcommand="$LAUNCH_PROFILE_SUBCOMMAND"
    if [[ "$LAUNCH_PROFILE_SOURCE" == "legacy-env" ]]; then
        case "$LAUNCH_PROFILE_LEGACY_COMMAND_MODE" in
            direct)
                # The configured legacy executable already dispatches to the
                # provider command (sptecode-codex invokes `stepcode codex`).
                subcommand="$LAUNCH_PROFILE_LEGACY_SUBCOMMAND"
                ;;
            profile)
                subcommand="$LAUNCH_PROFILE_SUBCOMMAND"
                ;;
            *)
                error "Unsupported legacy command mode for launch profile '$LAUNCH_PROFILE': ${LAUNCH_PROFILE_LEGACY_COMMAND_MODE:-<empty>}"
                ;;
        esac
        executable="${!LAUNCH_PROFILE_CLI_ENV}"
    fi

    if [[ -n "$LAUNCH_PROFILE_CODEX_HOME_SUFFIX" ]]; then
        if [[ -z "${HOME:-}" ]]; then
            error "HOME is required for the selected Codex launch profile."
        fi
        CODEX_HOME_OVERRIDE="${HOME%/}$LAUNCH_PROFILE_CODEX_HOME_SUFFIX"
    else
        CODEX_HOME_OVERRIDE=""
    fi
    if [[ -n "$LAUNCH_PROFILE_CODEX_SESSIONS_SUFFIX" ]]; then
        if [[ -z "${HOME:-}" ]]; then
            error "HOME is required for the selected Codex launch profile."
        fi
        CODEX_SESSIONS_OVERRIDE="${HOME%/}$LAUNCH_PROFILE_CODEX_SESSIONS_SUFFIX"
    else
        CODEX_SESSIONS_OVERRIDE=""
    fi

    local path
    if [[ "$LAUNCH_PROFILE_SOURCE" == "legacy-env" ]]; then
        path="$executable"
    else
        path=$(command -v "$executable" 2>/dev/null || true)
    fi
    if [[ -z "$path" || ! -x "$path" ]]; then
        error "$executable CLI is not found as an executable in PATH."
    fi
    if [[ "$path" == "$SCRIPT_DIR/codex-hud" || "$path" -ef "$SCRIPT_DIR/codex-hud" ]]; then
        error "$executable resolves to codex-hud wrapper. Fix the launch command to point to the real executable."
    fi

    CODEX_CLI_COMMAND=("$path")
    if [[ -n "$subcommand" ]]; then
        CODEX_CLI_COMMAND+=("$subcommand")
    fi
}

prepare_launch_profile_home() {
    if [[ -n "$CODEX_HOME_OVERRIDE" ]]; then
        if ! mkdir -p "$CODEX_HOME_OVERRIDE"; then
            error "Unable to create the managed Codex home: $CODEX_HOME_OVERRIDE"
        fi
    fi
    if [[ -n "$CODEX_SESSIONS_OVERRIDE" ]]; then
        if ! mkdir -p "$CODEX_SESSIONS_OVERRIDE"; then
            error "Unable to create the Codex sessions directory: $CODEX_SESSIONS_OVERRIDE"
        fi
    fi
}

resolve_sqlite_home() {
    CODEX_SQLITE_HOME_OVERRIDE=""
    CODEX_SQLITE_HOME_SOURCE=""
    CODEX_SQLITE_HOME_EXPLICIT="0"

    if [[ -n "${CODEX_SQLITE_HOME:-}" ]]; then
        CODEX_SQLITE_HOME_OVERRIDE="$CODEX_SQLITE_HOME"
        CODEX_SQLITE_HOME_EXPLICIT="1"
        return 0
    fi

    if [[ "$CODEX_SQLITE_ISOLATION_ENABLED" != "1" ]]; then
        return 0
    fi

    if [[ -n "$CODEX_HOME_OVERRIDE" ]]; then
        CODEX_SQLITE_HOME_SOURCE="$CODEX_HOME_OVERRIDE"
    elif [[ -n "${CODEX_HOME:-}" ]]; then
        CODEX_SQLITE_HOME_SOURCE="$CODEX_HOME"
    elif [[ -n "${HOME:-}" ]]; then
        CODEX_SQLITE_HOME_SOURCE="${HOME%/}/.codex"
    else
        error "HOME is required to derive the Codex SQLite home."
    fi

    CODEX_SQLITE_HOME_OVERRIDE="${CODEX_SQLITE_HOME_SOURCE%/}/.codex-hud-sqlite/$SESSION_NAME"
}

ensure_sqlite_state_link() {
    local database="$1"
    local source_path="${CODEX_SQLITE_HOME_SOURCE%/}/$database"
    local link_path="${CODEX_SQLITE_HOME_OVERRIDE%/}/$database"

    if [[ -L "$link_path" ]]; then
        local target
        target=$(readlink "$link_path" 2>/dev/null || true)
        if [[ "$target" == "$source_path" ]]; then
            return 0
        fi
        error "Conflicting Codex SQLite link: $link_path points to ${target:-<unreadable>}, expected $source_path."
    fi

    if [[ -e "$link_path" ]]; then
        error "Refusing to replace an existing Codex SQLite file: $link_path"
    fi

    if ! ln -s "$source_path" "$link_path"; then
        # Accept an identical link created between the preflight check and ln.
        if [[ -L "$link_path" ]] && [[ "$(readlink "$link_path" 2>/dev/null || true)" == "$source_path" ]]; then
            return 0
        fi
        error "Unable to link the existing Codex SQLite database: $link_path"
    fi
}

prepare_sqlite_home() {
    CODEX_SQLITE_ISOLATION_ENABLED=$(parse_boolean_setting \
        "CODEX_HUD_SQLITE_ISOLATION" \
        "${CODEX_HUD_SQLITE_ISOLATION:-}" \
        "0") || return 1
    resolve_sqlite_home

    if [[ -z "$CODEX_SQLITE_HOME_OVERRIDE" ]]; then
        return 0
    fi

    if [[ "$CODEX_SQLITE_HOME_EXPLICIT" == "1" ]]; then
        return 0
    fi

    if ! mkdir -p "$CODEX_SQLITE_HOME_OVERRIDE"; then
        error "Unable to create the Codex SQLite home: $CODEX_SQLITE_HOME_OVERRIDE"
    fi

    if ! mkdir -p "$CODEX_SQLITE_HOME_SOURCE"; then
        error "Unable to create the stable Codex home for SQLite metadata: $CODEX_SQLITE_HOME_SOURCE"
    fi

    # Keep thread, goal, and memory metadata shared with the existing Codex
    # home while giving each HUD launch its own log database. The links also
    # reserve the stable database paths before Codex creates them on a fresh
    # profile, so later launches keep using the same metadata files.
    # SQLite resolves sidecar WAL/SHM files through these links to the source
    # database, so active sessions retain their existing state semantics.
    ensure_sqlite_state_link "state_5.sqlite"
    ensure_sqlite_state_link "goals_1.sqlite"
    ensure_sqlite_state_link "memories_1.sqlite"
}

launch_environment_prefix() {
    local prefix=""
    if [[ -n "$CODEX_HOME_OVERRIDE" ]]; then
        prefix="CODEX_HOME=$(shell_quote "$CODEX_HOME_OVERRIDE") "
    fi
    if [[ -n "$CODEX_SESSIONS_OVERRIDE" ]]; then
        prefix="${prefix}CODEX_SESSIONS_PATH=$(shell_quote "$CODEX_SESSIONS_OVERRIDE") "
    fi
    if [[ -n "$CODEX_SQLITE_HOME_OVERRIDE" ]]; then
        prefix="${prefix}CODEX_SQLITE_HOME=$(shell_quote "$CODEX_SQLITE_HOME_OVERRIDE") "
    fi
    printf "%s" "$prefix"
}

# Get zsh rc file location (respects ZDOTDIR when set)
get_zsh_rc_file() {
    if [[ -n "${ZDOTDIR:-}" ]]; then
        echo "$ZDOTDIR/.zshrc"
        return 0
    fi
    echo "$HOME/.zshrc"
}

# Get the RC file for the current shell
get_shell_rc_file() {
    local shell_name
    shell_name=$(basename "$SHELL")
    case "$shell_name" in
        bash)
            if [[ -f "$HOME/.bashrc" ]]; then
                echo "$HOME/.bashrc"
            elif [[ -f "$HOME/.bash_profile" ]]; then
                echo "$HOME/.bash_profile"
            else
                echo "$HOME/.bashrc"
            fi
            ;;
        zsh)
            get_zsh_rc_file
            ;;
        fish)
            echo "$HOME/.config/fish/config.fish"
            ;;
        *)
            echo ""
            ;;
    esac
}

# Detect OS and package manager
detect_os() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        echo "macos"
    elif [[ -f /etc/debian_version ]]; then
        echo "debian"
    elif [[ -f /etc/redhat-release ]]; then
        echo "redhat"
    elif [[ -f /etc/arch-release ]]; then
        echo "arch"
    elif [[ -f /etc/alpine-release ]]; then
        echo "alpine"
    else
        echo "unknown"
    fi
}

# Install tmux automatically
install_tmux() {
    local os
    os=$(detect_os)
    
    step "Installing tmux..."
    
    case "$os" in
        macos)
            if command_exists brew; then
                brew install tmux
            else
                error "Homebrew not found. Please install Homebrew first: https://brew.sh"
            fi
            ;;
        debian)
            if command_exists sudo; then
                sudo apt-get update && sudo apt-get install -y tmux
            else
                apt-get update && apt-get install -y tmux
            fi
            ;;
        redhat)
            if command_exists sudo; then
                sudo yum install -y tmux || sudo dnf install -y tmux
            else
                yum install -y tmux || dnf install -y tmux
            fi
            ;;
        arch)
            if command_exists sudo; then
                sudo pacman -S --noconfirm tmux
            else
                pacman -S --noconfirm tmux
            fi
            ;;
        alpine)
            if command_exists sudo; then
                sudo apk add tmux
            else
                apk add tmux
            fi
            ;;
        *)
            error "Could not detect OS for automatic tmux installation.

Please install tmux manually:
  Linux (Debian/Ubuntu): sudo apt install tmux
  Linux (RHEL/CentOS):   sudo yum install tmux
  Linux (Arch):          sudo pacman -S tmux
  macOS:                 brew install tmux"
            ;;
    esac
    
    # Verify installation
    if command_exists tmux; then
        info "tmux installed successfully!"
    else
        error "tmux installation failed. Please install manually."
    fi
}

# Check dependencies (with auto-install for tmux)
check_dependencies() {
    # Check tmux - auto-install if missing
    if ! command_exists node; then
        error "Node.js is required but not installed.

Install Node.js 18+ from: https://nodejs.org/"
    fi

    resolve_launch_command

    if ! command_exists tmux; then
        warn "tmux is not installed."
        echo ""
        read -p "Would you like to install tmux automatically? [Y/n] " -n 1 -r
        echo ""
        if [[ $REPLY =~ ^[Yy]$ ]] || [[ -z $REPLY ]]; then
            install_tmux
        else
            error "tmux is required for codex-hud. Please install it manually."
        fi
    fi
}

# Build the HUD renderer if needed
build_hud() {
    local dist_file="$HUD_DIR/dist/index.js"
    local src_file="$HUD_DIR/src/index.ts"
    
    # Check if node_modules exists
    if [[ ! -d "$HUD_DIR/node_modules" ]]; then
        step "Installing dependencies..."
        (cd "$HUD_DIR" && npm install) || error "Failed to install dependencies"
    fi
    
    # Check if we need to build
    if [[ ! -f "$dist_file" ]] || [[ "$src_file" -nt "$dist_file" ]]; then
        step "Building HUD renderer..."
        (cd "$HUD_DIR" && npm run build) || error "Failed to build HUD renderer"
    fi
}

# Get the current working directory for Codex
get_cwd() {
    pwd
}

# Get the first pane ID in the session
get_primary_pane_id() {
    local session_name="${1:-$SESSION_NAME}"
    tmux list-panes -t "$session_name" -F "#{pane_id}" 2>/dev/null | head -n1
}

# Return 0 if a pane belongs to a session
pane_exists_in_session() {
    local session_name="$1"
    local pane_id="$2"

    if [[ -z "$session_name" || -z "$pane_id" ]]; then
        return 1
    fi

    tmux list-panes -t "$session_name" -F "#{pane_id}" 2>/dev/null | grep -Fx "$pane_id" >/dev/null
}

# Get the main Codex pane ID for a session
get_main_pane_id_for_session() {
    local session_name="${1:-$SESSION_NAME}"
    local stored_main
    local hud_pane
    local fallback_main

    stored_main=$(tmux show-option -t "$session_name" -qv @codex_hud_main_pane)
    if pane_exists_in_session "$session_name" "$stored_main"; then
        echo "$stored_main"
        return 0
    fi

    hud_pane=$(tmux show-option -t "$session_name" -qv @codex_hud_pane)
    if [[ -n "$hud_pane" ]]; then
        fallback_main=$(tmux list-panes -t "$session_name" -F "#{pane_id}" 2>/dev/null | grep -v "^${hud_pane}$" | head -n1 || true)
        if [[ -n "$fallback_main" ]]; then
            echo "$fallback_main"
            return 0
        fi
    fi

    get_primary_pane_id "$session_name"
}

# Find the most recent existing session for this directory
find_existing_session() {
    tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}-" | sort | tail -n1
}

set_fixed_hud_height() {
    local session_name="$1"
    local hud_pane_id="$2"
    local height="$3"
    local main_pane_id="${4:-}"
    local resize_helper="$SCRIPT_DIR/codex-hud-resize"

    if [[ -z "$session_name" || -z "$hud_pane_id" || -z "$height" ]]; then
        return 0
    fi

    local auto_setting
    local min_setting
    local max_setting

    auto_setting="${CODEX_HUD_HEIGHT_AUTO:-}"
    if [[ -z "$auto_setting" ]]; then
        auto_setting=$(tmux show-option -t "$session_name" -qv @codex_hud_auto)
    fi
    if [[ -z "$auto_setting" ]]; then
        auto_setting="0"
    fi

    min_setting="${CODEX_HUD_HEIGHT_MIN:-}"
    if [[ -z "$min_setting" ]]; then
        min_setting=$(tmux show-option -t "$session_name" -qv @codex_hud_height_min)
    fi
    if [[ -z "$min_setting" ]]; then
        min_setting="$height"
    fi

    max_setting="${CODEX_HUD_HEIGHT_MAX:-}"
    if [[ -z "$max_setting" ]]; then
        max_setting=$(tmux show-option -t "$session_name" -qv @codex_hud_height_max)
    fi
    if [[ -z "$max_setting" ]]; then
        max_setting="12"
    fi

    local focus_main_setting
    focus_main_setting="1"

    tmux set-option -t "$session_name" -q @codex_hud_pane "$hud_pane_id"
    tmux set-option -t "$session_name" -q @codex_hud_auto "$auto_setting"
    tmux set-option -t "$session_name" -q @codex_hud_height_min "$min_setting"
    tmux set-option -t "$session_name" -q @codex_hud_height_max "$max_setting"
    tmux set-option -t "$session_name" -q @codex_hud_base_height "$height"
    tmux set-option -t "$session_name" -q @codex_hud_height "$height"
    tmux set-option -t "$session_name" -q @codex_hud_focus_main "$focus_main_setting"
    if [[ -n "$main_pane_id" ]]; then
        tmux set-option -t "$session_name" -q @codex_hud_main_pane "$main_pane_id"
    fi

    if [[ -x "$resize_helper" ]]; then
        "$resize_helper" "$session_name"
    else
        tmux resize-pane -t "$hud_pane_id" -y "$height" 2>/dev/null || true
    fi

    local hook_cmd
    if [[ -x "$resize_helper" ]]; then
        hook_cmd="run-shell \"$resize_helper #{session_name}\""
        tmux set-hook -t "$session_name" client-resized "$hook_cmd"
        tmux set-hook -t "$session_name" after-resize-pane "$hook_cmd"
    fi
}

# Check if session already exists and is usable
check_existing_session() {
    local attach_policy
    attach_policy=$(resolve_attach_policy) || exit 1
    if [[ "$attach_policy" != "attach" ]]; then
        return 1
    fi

    local existing
    existing=$(find_existing_session)
    if [[ -n "$existing" ]]; then
        SESSION_NAME="$existing"
        return 0
    fi
    return 1
}

# Cleanup function - only cleanup on explicit exit, not on attach to existing
cleanup() {
    # Remove only an orphan created before a client attaches successfully.
    # A normal detach returns from attach-session while Codex is still running;
    # that session must remain alive until its main pane exits.
    if [[ "${SESSION_CREATED:-}" == "true" && "${SESSION_PRESERVE_ON_EXIT:-}" != "true" ]]; then
        abort_update_session "${CURRENT_CHECKOUT_PATH:-$(pwd)}"
        if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
            tmux kill-session -t "$SESSION_NAME" 2>/dev/null || true
        fi
    fi
}

# Attach a client to the HUD session without asking tmux to attach through an
# existing client. When the wrapper is launched from a tmux pane, tmux rejects
# a plain nested `attach-session` and the cleanup trap would remove the new
# session before the user can see it. Reuse the owning socket explicitly and
# clear TMUX only for the child client so the outer session remains intact.
attach_session() {
    local session_name="$1"
    if [[ -z "${TMUX:-}" ]]; then
        tmux attach-session -t "$session_name"
        return
    fi

    local tmux_socket="${TMUX%%,*}"
    if [[ -z "$tmux_socket" || "$tmux_socket" == "$TMUX" ]]; then
        error "Unable to determine the owning tmux socket for nested attach."
    fi
    TMUX= tmux -S "$tmux_socket" attach-session -t "$session_name"
}

# Resolve HUD height based on terminal size
resolve_hud_height() {
    local term_height="$1"
    local requested="$HUD_HEIGHT"
    local min_height=5
    local max_height=$((term_height - 1))
    if [[ "$max_height" -lt 1 ]]; then
        max_height=1
    fi
    
    if [[ -n "$requested" ]]; then
        if ! [[ "$requested" =~ ^[0-9]+$ ]]; then
            error "CODEX_HUD_HEIGHT must be a positive integer (got: $requested)"
        fi
        if [[ "$requested" -gt "$max_height" ]]; then
            HUD_HEIGHT="$max_height"
            return 0
        fi
        if [[ "$requested" -lt 1 ]]; then
            HUD_HEIGHT="1"
            return 0
        fi
        HUD_HEIGHT="$requested"
        return 0
    fi
    
    local desired=5
    if [[ "$desired" -lt "$min_height" ]]; then
        desired="$min_height"
    fi
    if [[ "$desired" -gt "$max_height" ]]; then
        desired="$max_height"
    fi
    if [[ "$desired" -lt 1 ]]; then
        desired="1"
    fi
    HUD_HEIGHT="$desired"
}

# Create new tmux session with HUD
create_session() {
    local cwd="$1"
    CURRENT_CHECKOUT_PATH="$cwd"
    shift
    local codex_args=("$@")
    local cwd_escaped
    cwd_escaped=$(shell_quote "$cwd")
    
    # Calculate terminal dimensions
    local term_height
    local term_width
    term_height=$(tput lines 2>/dev/null || echo 24)
    term_width=$(tput cols 2>/dev/null || echo 80)
    resolve_hud_height "$term_height"
    prepare_launch_profile_home
    prepare_sqlite_home
    
    # Build the launch command string from the resolved profile vector.
    # Quote every executable, subcommand, and forwarded argument before
    # embedding the command in the tmux pane shell.
    local codex_cmd=""
    local command_part
    for command_part in "${CODEX_CLI_COMMAND[@]}"; do
        if [[ -z "$codex_cmd" ]]; then
            codex_cmd=$(shell_quote "$command_part")
        else
            codex_cmd="$codex_cmd $(shell_quote "$command_part")"
        fi
    done
    for arg in "${codex_args[@]}"; do
        codex_cmd="$codex_cmd $(shell_quote "$arg")"
    done
    local launch_env_prefix
    launch_env_prefix=$(launch_environment_prefix)
    if [[ -n "$launch_env_prefix" ]]; then
        codex_cmd="$launch_env_prefix$codex_cmd"
    fi
    
    # Create new detached session
    tmux new-session -d -s "$SESSION_NAME" -x "$term_width" -y "$term_height"
    SESSION_CREATED="true"
    # Mark the session so management commands can discover custom legacy
    # prefixes without coupling discovery to a session-name convention.
    tmux set-option -t "$SESSION_NAME" -q @codex_hud_session 1
    # Register this update-enabled session before any command is sent to it.
    register_update_session "$cwd"
    # Keep wheel scrolling available in Codex pane by default.
    local mouse_setting
    mouse_setting=$(parse_boolean_setting "CODEX_HUD_MOUSE" "${CODEX_HUD_MOUSE:-}" "1") || exit 1

    if [[ "$mouse_setting" == "1" ]]; then
        tmux set-option -t "$SESSION_NAME" mouse on
        tmux set-option -t "$SESSION_NAME" wheel-scroll-lines 1 2>/dev/null || true
    else
        tmux set-option -t "$SESSION_NAME" mouse off
    fi

    tmux set-option -t "$SESSION_NAME" escape-time 0
    tmux set-option -t "$SESSION_NAME" assume-paste-time 0
    tmux set-option -t "$SESSION_NAME" repeat-time 0
    tmux set-option -t "$SESSION_NAME" history-limit 200000

    local alternate_screen
    alternate_screen=$(resolve_alternate_screen_setting) || exit 1
    if [[ "$alternate_screen" == "1" ]]; then
        tmux set-window-option -t "$SESSION_NAME" alternate-screen on
    else
        tmux set-window-option -t "$SESSION_NAME" alternate-screen off
    fi
    local main_pane_id
    main_pane_id=$(get_primary_pane_id)
    if [[ -z "$main_pane_id" ]]; then
        error "Failed to detect tmux pane for session: $SESSION_NAME"
    fi
    
    # Codex probes the terminal during startup. Start it only after a tmux
    # client is attached so terminal replies are not delivered to the shell.
    # A plain (non-append) set-hook is used to match the rest of this script and
    # to avoid the tmux >= 3.2 requirement of `set-hook -a`; this session sets no
    # other client-attached hook, so overwrite and append are equivalent here.
    tmux set-option -t "$SESSION_NAME" -q @codex_hud_client_attached 0
    tmux set-hook -t "$SESSION_NAME" client-attached "set-option -t '$SESSION_NAME' -q @codex_hud_client_attached 1"

    # Start the gated codex command as the pane's process. Successful exits
    # retain the existing automatic session cleanup. Interrupt status 130
    # detaches immediately; other failed exits keep the original Codex output
    # visible until acknowledgement, then return the status through tmux.
    # Using respawn-pane avoids injecting the launch into an interactive shell
    # with send-keys, which would echo the full command into the user's terminal
    # before Codex starts.
    # The wait is capped (~10s = 200 * 0.05s) and fails open: if no client ever
    # attaches, codex still starts rather than leaving the pane hung forever. In
    # that fail-open path the probe leak this gate guards against can recur, but a
    # bounded wait is preferred over an unbounded hang when no client appears.
    local attach_gate_cmd
    attach_gate_cmd="i=0; while [ \"\$(tmux show-option -t '$SESSION_NAME' -qv @codex_hud_client_attached)\" != \"1\" ] && [ \"\$i\" -lt 200 ]; do sleep 0.05; i=\$((i+1)); done"
    local codex_launch_cmd
    codex_launch_cmd="$attach_gate_cmd; cd ${cwd_escaped} && $codex_cmd; codex_status=\$?; if [ \"\$codex_status\" -eq 130 ]; then if ! tmux detach-client -s '$SESSION_NAME' -E \"exit \$codex_status\"; then printf '[codex-hud] Unable to return interrupt status through tmux client; exiting with status %s.\\n' \"\$codex_status\" >&2; fi; exit \"\$codex_status\"; fi; if [ \"\$codex_status\" -ne 0 ]; then printf '\\n[codex-hud] Codex exited with status %s. Press Enter to close.\\n' \"\$codex_status\" >&2; if ! IFS= read -r _codex_hud_close; then printf '[codex-hud] Input closed before acknowledgement; returning status %s.\\n' \"\$codex_status\" >&2; fi; if ! tmux detach-client -s '$SESSION_NAME' -E \"exit \$codex_status\"; then printf '[codex-hud] Unable to return status through tmux client; exiting with status %s.\\n' \"\$codex_status\" >&2; fi; exit \"\$codex_status\"; fi; tmux kill-session -t '$SESSION_NAME'"
    local pane_shell="${CODEX_PANE_SHELL_PATH:-}"
    if [[ -n "$pane_shell" ]]; then
        validate_shell_path "$pane_shell"
        local shell_command
        shell_command=$(printf "%q -ilc %q" "$pane_shell" "$codex_launch_cmd")
        tmux respawn-pane -k -t "$main_pane_id" "$shell_command"
    else
        tmux respawn-pane -k -t "$main_pane_id" "$codex_launch_cmd"
    fi

    # StepCode can deliver SIGINT to the full foreground process group, which
    # ends this pane shell before the inline teardown above can run. Keep the
    # pane exit metadata and let tmux return status 130 independently.
    local pane_died_cmd
    pane_died_cmd="if-shell -F '#{==:#{pane_dead_signal},2}' \"detach-client -s '$SESSION_NAME' -E 'exit 130'\" ; kill-session -t '$SESSION_NAME'"
    tmux set-option -p -t "$main_pane_id" remain-on-exit on
    tmux set-option -p -t "$main_pane_id" pane-died "$pane_died_cmd"
    
    # Wait a moment for the session to be ready
    sleep 0.2
    
    # Split the window based on HUD_POSITION
    local session_start
    session_start=$(date +%s)
    local hud_env_prefix
    hud_env_prefix=$(launch_environment_prefix)
    local hud_cmd="cd ${cwd_escaped} && ${hud_env_prefix}LINES='$HUD_HEIGHT' COLUMNS='$term_width' CODEX_HUD_CWD=${cwd_escaped} CODEX_HUD_MAIN_PANE='$main_pane_id' CODEX_HUD_SESSION_START='$session_start' CODEX_HUD_TMUX_SESSION='$SESSION_NAME' CODEX_HUD_CLEAR_SCROLLBACK='${CODEX_HUD_CLEAR_SCROLLBACK:-}' node '$HUD_DIR/dist/index.js'"
    
    if [[ "$HUD_POSITION" == "top" ]]; then
        # Split at top, then swap panes
        local hud_pane_id
        hud_pane_id=$(tmux split-window -v -t "$SESSION_NAME" -l "$HUD_HEIGHT" -b -P -F "#{pane_id}" "$hud_cmd")
        tmux select-pane -t "$main_pane_id"
    else
        # Default: bottom
        local hud_pane_id
        hud_pane_id=$(tmux split-window -v -t "$SESSION_NAME" -l "$HUD_HEIGHT" -P -F "#{pane_id}" "$hud_cmd")
        tmux select-pane -t "$main_pane_id"
    fi

    if [[ -n "${hud_pane_id:-}" ]]; then
        set_fixed_hud_height "$SESSION_NAME" "$hud_pane_id" "$HUD_HEIGHT" "$main_pane_id"
    fi

    # tmux key tables are server-wide; keep the legacy binding opt-in so a HUD
    # session cannot overwrite Prefix+H for unrelated user sessions.
    local bind_toggle
    bind_toggle=$(parse_boolean_setting "CODEX_HUD_BIND_TOGGLE" "${CODEX_HUD_BIND_TOGGLE:-}" "0") || exit 1
    if [[ "$bind_toggle" == "1" ]]; then
        tmux bind-key -T prefix H run-shell "tmux if-shell -F '#{@codex_hud_pane}' 'tmux send-keys -t #{@codex_hud_pane} C-t' ''"
    fi
    
}

# Main function
main() {
    local codex_args=()

    # Parse wrapper arguments and pass the rest to codex CLI.
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            --attach)
                FORCE_ATTACH="1"
                ;;
            --new-session)
                FORCE_NEW_SESSION="1"
                ;;
            --stepcode)
                LAUNCH_PROFILE="stepcode"
                ;;
            --)
                shift
                codex_args+=("$@")
                break
                ;;
            *)
                codex_args+=("$1")
                ;;
        esac
        shift
    done
    resolve_launch_profile
    refresh_session_identity

    # Check dependencies
    check_dependencies
    
    # Build HUD if needed
    build_hud
    
    # Get current working directory
    local cwd
    cwd=$(get_cwd)
    
    # Check for existing session
    if check_existing_session; then
        info "Attaching to existing session: $SESSION_NAME"
        local main_pane_id
        main_pane_id=$(get_main_pane_id_for_session "$SESSION_NAME")
        if [[ -n "$main_pane_id" ]]; then
            tmux select-pane -t "$main_pane_id" 2>/dev/null || true
        fi
        local hud_pane_id
        hud_pane_id=$(tmux show-option -t "$SESSION_NAME" -qv @codex_hud_pane)
        if [[ -n "$hud_pane_id" ]]; then
            set_fixed_hud_height "$SESSION_NAME" "$hud_pane_id" "$HUD_HEIGHT" "$main_pane_id"
        fi
        attach_session "$SESSION_NAME"
        return 0
    fi

    # A new session is the only launch path that may interrupt the user with
    # an update prompt; reused sessions deliberately skip the check.
    run_update_check "$cwd"
    
    # Set up cleanup trap
    trap cleanup EXIT
    
    # Create new session
    info "Starting Codex with HUD (session: $SESSION_NAME)..."
    create_session "$cwd" "${codex_args[@]}"
    
    # Attach to the session
    local main_pane_id
    main_pane_id=$(get_main_pane_id_for_session "$SESSION_NAME")
    if [[ -n "$main_pane_id" ]]; then
        tmux select-pane -t "$main_pane_id" 2>/dev/null || true
    fi
    attach_session "$SESSION_NAME"
    SESSION_PRESERVE_ON_EXIT="true"
}

# Show help
show_help() {
    cat << EOF
codex-hud - Codex CLI with HUD display

Usage: codex-hud [options] [codex options...]

This wrapper launches Codex in a tmux session with a real-time status bar
showing model info, git status, project info, token usage, and more.

All arguments are passed through to the codex command.

Options:
  -h, --help          Show this help message
  --self-check        Run environment diagnostics
  --kill              Kill existing session for current directory
  --list              List all codex-hud sessions
  --attach            Attach to latest existing session in this directory
  --new-session       Always create a new session for this launch
  --stepcode          Launch StepCode Codex through \`stepcode codex\`

Environment Variables:
  CODEX_HUD_POSITION  HUD pane position: bottom (default), top
  CODEX_HUD_HEIGHT    HUD pane height in lines (default: 5)
  CODEX_HUD_HEIGHT_AUTO Auto-adjust HUD height based on pane width (default: 0)
  CODEX_HUD_HEIGHT_MIN Minimum HUD height when auto-adjusting (default: CODEX_HUD_HEIGHT)
  CODEX_HUD_HEIGHT_MAX Maximum HUD height when auto-adjusting (default: 12)
  CODEX_HUD_AUTO_ATTACH Auto-attach to latest existing session (default: 0)
  CODEX_HUD_NO_ATTACH Deprecated: force new session (overrides auto attach)
  CODEX_HUD_ALTERNATE_SCREEN Use alternate screen in codex pane (default: 0)
  CODEX_HUD_MOUSE Enable tmux mouse mode for this session (default: 1)
  CODEX_HUD_BIND_TOGGLE Install the legacy server-wide Prefix+H toggle (default: 0)
  CODEX_HUD_CLEAR_SCROLLBACK Clear terminal scrollback on first render (default: 0)
  CODEX_HUD_SQLITE_ISOLATION Use a launch-scoped SQLite home (default: 0)
  CODEX_HUD_UPDATE_CHECK Check GitHub releases and offer deferred updates (default: enabled; 0/false disables)

Requirements:
  - tmux (auto-installed if missing)
  - Node.js 18+
  - Codex CLI or StepCode CLI

Examples:
  codex-hud                    Start Codex with HUD
  codex-hud --model gpt-5      Start with specific model
  codex-hud "help me debug"    Start with initial prompt
  codex-hud --kill             Kill existing session
  codex-hud --attach            Reuse existing session intentionally
  codex-hud --new-session       Force a new session
  codex-hud --stepcode --new-session  Start StepCode Codex with HUD
  CODEX_HUD_POSITION=top codex-hud  HUD on top

For more information, see: https://github.com/openai/codex
EOF
}

# Run environment diagnostics
self_check() {
    local failures=0
    
    echo "Codex HUD self-check"
    echo ""
    
    if [[ -n "${ZDOTDIR:-}" ]] && [[ ! -d "$ZDOTDIR" ]]; then
        warn "ZDOTDIR is set but does not exist: $ZDOTDIR"
        failures=$((failures + 1))
    fi
    
    local codex_path
    codex_path=$(command -v codex 2>/dev/null || true)
    if [[ -n "$codex_path" ]]; then
        info "codex: $codex_path"
        if [[ "$codex_path" == "$SCRIPT_DIR/codex-hud" ]]; then
            warn "codex resolves to codex-hud wrapper; fix alias to the real codex CLI."
            failures=$((failures + 1))
        fi
    else
        warn "codex CLI not found in PATH"
        failures=$((failures + 1))
    fi
    
    if command_exists node; then
        info "node $(node --version)"
    else
        warn "node not found in PATH"
        failures=$((failures + 1))
    fi
    
    if command_exists tmux; then
        info "tmux $(tmux -V)"
        local pane_index
        pane_index=$(tmux show-options -gqv pane-base-index)
        if [[ -n "$pane_index" && "$pane_index" != "0" ]]; then
            info "tmux pane-base-index=$pane_index (supported)"
        fi
    else
        warn "tmux not found in PATH"
        failures=$((failures + 1))
    fi
    
    local rc_file
    rc_file=$(get_shell_rc_file)
    if [[ -z "$rc_file" ]]; then
        warn "Unable to determine shell rc file for: $SHELL"
        failures=$((failures + 1))
    elif [[ ! -f "$rc_file" ]]; then
        warn "RC file not found: $rc_file"
        failures=$((failures + 1))
    elif grep -q "$ALIAS_MARKER" "$rc_file" 2>/dev/null; then
        info "Alias marker found in $rc_file"
    else
        warn "Alias marker not found in $rc_file"
        failures=$((failures + 1))
    fi
    
    if [[ ! -f "$HUD_DIR/dist/index.js" ]]; then
        warn "HUD build output not found: $HUD_DIR/dist/index.js"
    fi
    
    if [[ "$failures" -gt 0 ]]; then
        warn "Self-check found $failures issue(s)."
        exit 1
    fi
    
    info "Self-check passed."
}

# Kill existing session
kill_session() {
    local sessions
    sessions=$(tmux list-sessions -F "#{session_name}" 2>/dev/null | grep "^${SESSION_PREFIX}" || true)
    if [[ -z "$sessions" ]]; then
        warn "No session found: $SESSION_PREFIX"
        return
    fi
    while IFS= read -r session_name; do
        if [[ -n "$session_name" ]]; then
            tmux kill-session -t "$session_name"
        fi
    done <<< "$sessions"
    info "Session(s) '$SESSION_PREFIX' killed."
}

# List all codex-hud sessions
list_sessions() {
    echo "Active codex-hud sessions:"
    local session_rows
    if ! session_rows=$(tmux list-sessions -F '#{session_name} #{@codex_hud_session}'); then
        error "Unable to list tmux sessions for codex-hud."
    fi
    local found="0"
    local session_name
    local marker
    while IFS=' ' read -r session_name marker _; do
        if [[ -z "$session_name" ]]; then
            continue
        fi
        # The marker covers every session created by this version, including
        # arbitrary validated legacy prefixes. The prefix fallback keeps older
        # native and StepCode HUD sessions visible after an upgrade.
        if [[ "$marker" == "1" || "$session_name" == codex-hud-* || "$session_name" == stepcode-codex-hud-* ]]; then
            printf '%s\n' "$session_name"
            found="1"
        fi
    done <<< "$session_rows"
    if [[ "$found" != "1" ]]; then
        echo "  (none)"
    fi
}

# Check for special flags first
normalize_launch_profile_args() {
    local normalized_args=()
    local before_separator="1"
    local arg

    for arg in "$@"; do
        if [[ "$before_separator" == "1" && "$arg" == "--stepcode" ]]; then
            LAUNCH_PROFILE="stepcode"
            LAUNCH_PROFILE_EXPLICIT="1"
            continue
        fi
        normalized_args+=("$arg")
        if [[ "$before_separator" == "1" && "$arg" == "--" ]]; then
            before_separator="0"
        fi
    done

    NORMALIZED_ARGS=("${normalized_args[@]}")
}

NORMALIZED_ARGS=()
normalize_launch_profile_args "$@"
set -- "${NORMALIZED_ARGS[@]}"

# Profile-independent management commands must remain available when a stale
# legacy environment points at an invalid provider executable. These commands
# do not create or attach a Codex session, so dispatch them before profile
# validation.
case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    --list)
        if command_exists tmux; then
            list_sessions
        else
            error "tmux not installed"
        fi
        exit 0
        ;;
esac

resolve_legacy_launch_profile
resolve_launch_profile
refresh_session_identity

case "${1:-}" in
    --self-check)
        self_check
        exit 0
        ;;
    --kill)
        # Need to check dependencies to ensure tmux is available
        if command_exists tmux; then
            kill_session
        else
            error "tmux not installed"
        fi
        exit 0
        ;;
esac

# Run main
main "$@"
